# ============================================================================
# PrivacyGuard Environment Configuration & Secrets Management Template
# Copy this file to '.env' for local deployment. Never commit '.env' to git!
# ============================================================================

# Network & Server
HOST=127.0.0.1
PORT=8000
NODE_ENV=development

# Application Security Secret (Used for HMAC signing and token encryption)
APP_SECRET_KEY=replace_with_a_secure_random_64_character_hex_key

# Database Connections
DATABASE_URL=sqlite:///backend/privacyguard.db
MONGO_URI=mongodb://127.0.0.1:27017/privacyguard_audit

# AI Copilot Integration (Optional local mock or Gemini key)
GEMINI_API_KEY=
ENABLE_AI_COPILOT=true

# Logging & Monitoring
LOG_LEVEL=INFO
ENABLE_PERF_METRICS=true
